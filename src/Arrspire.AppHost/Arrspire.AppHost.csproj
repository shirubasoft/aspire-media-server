<Project Sdk="Aspire.AppHost.Sdk/13.4.6">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Arrspire.AppHost</RootNamespace>
    <UserSecretsId>arrspire-apphost</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIREINTERACTION001;ASPIRECONTAINERRUNTIME001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" Version="13.4.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Arrspire.ContainerRunner/Arrspire.ContainerRunner.csproj" />
    <ProjectReference Include="../Arrspire.Notifier/Arrspire.Notifier.csproj" />
  </ItemGroup>
</Project>
